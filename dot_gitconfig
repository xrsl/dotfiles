[color]
	ui = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[core]
	excludesfile = ~/.gitignore_global
	pager = hunk pager
	editor = fresh --cmd session open-file . --wait

[interactive]
    diffFilter = delta --color-only

# [delta]
#     navigate = true  # use n and N to move between diff sections
#     dark = true      # or light = true, or omit for auto-detection
# 	line-numbers = true
# 	side-by-side = true
    # side-by-side = true

[merge]
    conflictStyle = zdiff3
    # hunk cannot do 3-way; nvim can. `git mergetool` opens the default
    # (LOCAL,BASE,REMOTE)/MERGED layout: three read-only panes over the merged buffer.
    # From the bottom pane, pull a side in by BUFFER NAME -- git names its temp files
    # f_LOCAL_<pid>.ext, so the name is what :diffget matches:
    #     :diffget LOCAL     take ours for the hunk under the cursor
    #     :diffget REMOTE    take theirs
    #     %diffget REMOTE    take theirs for the whole file
    # NOT :diffget //2 and //3 -- that is the old vimdiff backend and fails with E94.
    tool = nvimdiff

[mergetool]
    # no f.txt.orig left behind after every resolve; the pre-merge content is
    # still in the index and in ORIG_HEAD if a resolve goes wrong.
    keepBackup = false

# hunk renders difftool file pairs too, so `git difftool` uses the same viewer
# as the pager and the h/hpr wrappers.
[diff]
    tool = hunk
[difftool]
    prompt = false
[difftool "hunk"]
    cmd = hunk difftool "$LOCAL" "$REMOTE" "$MERGED"

[include]
    path = ~/.gitconfig.local
    path = ~/.config/delta/catppuccin/catppuccin.gitconfig

# delta is no longer a viewer you invoke: `hunk pager` is core.pager now.
# It stays for lazygit's diffRenderers and `git add -p` colouring, and reads
# these styles from here.
[delta]
  features = catppuccin-mocha
  syntax-theme = tokyonight_night
  dark = true
  tabs = 2
  line-numbers = false

  # delta now only renders inside lazygit, which already names the file in its panel
  file-style = omit
  file-decoration-style = none

  # Hunk headers: line number + syntax context, no boxes/underlines
  hunk-header-style = line-number syntax
  hunk-header-decoration-style = none

  keep-plus-minus-markers = false

  # Claude Code-like full-line backgrounds and non-bold word emphasis
  plus-style = syntax "#003800"
  plus-emph-style = syntax "#0B5A0B"
  minus-style = syntax "#5A0000"
  minus-emph-style = syntax "#7A1212"

  wrap-left-symbol = " "
  wrap-right-symbol = " "
  wrap-right-prefix-symbol = " "

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
[url "https://gist.github.com/"]
	insteadOf = git@gist.github.com:
	insteadOf = ssh://git@gist.github.com/
[alias]
	pr = "!f() { exec az repos pr \"$@\"; }; f"
	repo = "!f() { exec az repos \"$@\"; }; f"
