[color]
	ui = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[core]
	excludesfile = ~/.gitignore_global
	pager = delta
	editor = fresh --cmd session open-file . --wait

[interactive]
    diffFilter = delta --color-only

# [delta]
#     navigate = true  # use n and N to move between diff sections
#     dark = true      # or light = true, or omit for auto-detection
# 	line-numbers = true
# 	side-by-side = true
    # side-by-side = true

[merge]
    conflictStyle = zdiff3

[include]
    path = ~/.gitconfig.local
    path = ~/.config/delta/catppuccin/catppuccin.gitconfig
[pager]
	diff = diffnav

[delta]
  features = catppuccin-mocha
  syntax-theme = tokyonight_night
  navigate = true
  dark = true
  tabs = 2
  line-numbers = false

  # diffnav's file tree already shows paths; keep delta's file header out of the way
  file-style = omit
  file-decoration-style = none

  # Hunk headers: line number + syntax context, no boxes/underlines
  hunk-header-style = line-number syntax
  hunk-header-decoration-style = none

  keep-plus-minus-markers = false

  # Claude Code-like full-line backgrounds and non-bold word emphasis
  plus-style = syntax "#003800"
  plus-emph-style = syntax "#0B5A0B"
  minus-style = syntax "#5A0000"
  minus-emph-style = syntax "#7A1212"

  wrap-left-symbol = " "
  wrap-right-symbol = " "
  wrap-right-prefix-symbol = " "

[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
