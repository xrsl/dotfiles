#!/bin/sh
set -eu

message=$(
    CLAUDECODE= MAX_THINKING_TOKENS=0 claude -p \
        --no-session-persistence \
        --model=claude-haiku-5-5 \
        --tools='' \
        --disable-slash-commands \
        --setting-sources='' \
        --system-prompt=''
)

subject=$(printf '%s\n' "$message" | sed -n '1p')
if [ -z "$subject" ] || [ "$subject" = null ] || ! printf '%s\n' "$subject" | grep -Eq '^[[:alpha:]]+(\([^)]*\))?!?: .+'; then
    echo "wt commit: Claude returned an invalid Conventional Commit message: $subject" >&2
    exit 1
fi

printf '%s\n' "$message"
