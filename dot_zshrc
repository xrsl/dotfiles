# wtcode stays a function: its `cd` back to the original dir can't persist from an alias.
alias wtl='wt l'
alias wts='wt s'
# wtn <branch> [<base>]: 'wt new'. Optional 2nd positional is the base ref
# (main, origin/main, @; '.' is rewritten to @). Defaults to origin/main.
wtn() {
  local branch base
  local -a rest
  (( $# )) && { branch="$1"; shift; }
  (( $# )) && [[ "$1" != -* ]] && { base="$1"; shift; }
  rest=("$@")
  [[ "$base" == "." ]] && base="@"
  if [[ -n "$base" ]]; then
    wt new "$branch" --base "$base" "${rest[@]}"
  elif [[ -n "$branch" ]]; then
    wt new "$branch" "${rest[@]}"
  else
    wt new
  fi
}
