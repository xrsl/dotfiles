# d — review working-tree changes in diffnav.
#   d        unified view (default)
#   d -s     side-by-side view
d() {
  if (( $# == 0 )); then
    git diff | diffnav -u
  else
    git diff | diffnav "$@"
  fi
}

# dpr — review branch changes against the local default branch ref.
#   dpr       unified view (default)
#   dpr -s    side-by-side view
dpr() {
  local base

  base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  if [[ -z "$base" ]]; then
    for c in main master; do
      git show-ref --quiet --verify "refs/heads/$c" 2>/dev/null && { base=$c; break; }
    done
  fi
  [[ -z "$base" ]] && base=main

  if (( $# == 0 )); then
    git diff "${base}..HEAD" | diffnav -u
  else
    git diff "${base}..HEAD" | diffnav "$@"
  fi
}

# HUNK — review-first TUI for agent-authored changesets (github.com/modem-dev/hunk).
# Parallels d/dpr. `hunk diff` reads the repo directly (untracked included);
# `hunk patch -` reads a precomputed diff from stdin (hunk has no git revset for ranges).
#   h        working-tree changes
#   hw       working-tree changes, --watch (stays open beside a running agent)
#   hpr      branch changes vs the merge-base with the default branch (what `gh pr diff` shows)
h()  { command hunk diff "$@"; }
hw() { command hunk diff --watch "$@"; }
hpr() {
  local base

  base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  if [[ -z "$base" ]]; then
    for c in main master; do
      git show-ref --quiet --verify "refs/heads/$c" 2>/dev/null && { base=$c; break; }
    done
  fi
  [[ -z "$base" ]] && base=main

  # Three-dot: diff against the merge-base, so commits that landed on the default
  # branch after we forked don't show up inverted. Matches `gh pr diff` / the GitHub UI.
  git diff "${base}...HEAD" --no-color | command hunk patch -
}


