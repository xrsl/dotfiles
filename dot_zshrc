# ci — review CI in gh-enhance. Auto-resolves the target:
#   ci                          PR for current branch → else latest run on branch
#   ci 1234                     review PR #1234 explicitly
#   ci --run 28715063843        review a workflow run by ID
#   ci <url> / other gh-enhance args are passed through verbatim
ci() {
  if (( $# > 0 )); then
    ENHANCE_THEME=catppuccin_mocha gh enhance "$@"
    return $?
  fi
  local branch pr run
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  # 1. PR for the current branch (feature branches)
  pr=$(gh pr view --json number -q .number 2>/dev/null)
  if [[ -n "$pr" ]]; then
    ENHANCE_THEME=catppuccin_mocha gh enhance "$pr"
    return $?
  fi
  # 2. No PR → latest workflow run on this branch (e.g. main, worktrees)
  run=$(gh run list --branch "$branch" --limit 1 --json databaseId -q '.[0].databaseId' 2>/dev/null)
  if [[ -n "$run" ]]; then
    echo "ci: no PR for '$branch'; opening latest run #$run" >&2
    ENHANCE_THEME=catppuccin_mocha gh enhance --run "$run"
    return $?
  fi
  echo "ci: no PR and no workflow runs found for branch '$branch'" >&2
  return 1
}

# cir — pick a recent workflow run on the current branch via fzf, open it in gh-enhance.
#   cir              list recent runs on the current branch (fzf picker)
#   cir main         list recent runs on a specific branch
#   cir --all        list recent runs across all branches
cir() {
  local branch
  if [[ "$1" == "--all" ]]; then
    branch=""
  else
    branch="${1:-$(git rev-parse --abbrev-ref HEAD 2>/dev/null)}"
  fi
  local runs header
  if [[ -n "$branch" ]]; then
    runs=$(gh run list --branch "$branch" --limit 30 \
      --json databaseId,status,conclusion,event,displayTitle,createdAt \
      -q '.[] | [.databaseId,.status,(.conclusion // "—"),.event,.createdAt[:10],.displayTitle] | @tsv')
    header=$(printf 'ID\tSTATUS\tRESULT\tEVENT\tDATE\tTITLE')
  else
    runs=$(gh run list --limit 30 \
      --json databaseId,status,conclusion,event,displayTitle,createdAt,headBranch \
      -q '.[] | [.databaseId,.status,(.conclusion // "—"),.event,.headBranch,.displayTitle] | @tsv')
    header=$(printf 'ID\tSTATUS\tRESULT\tEVENT\tBRANCH\tTITLE')
  fi
  if [[ -z "$runs" ]]; then
    echo "cir: no workflow runs found${branch:+ on branch '$branch'}" >&2
    return 1
  fi
  local pick
  pick=$(printf '%s\n%s\n' "$header" "$(printf '%s\n' "$runs" | tail -r)" \
    | fzf --header-lines=1 \
          --header="Recent runs${branch:+ on $branch} — Enter to open in enhance" \
          --header-first \
          --tabstop=12 --delimiter='\t' \
          --with-nth=2,3,4,5,6 \
          --preview='gh run view {1} --log 2>/dev/null | tail -40' \
          --preview-window='down:60%:wrap' \
          --bind='enter:execute(ENHANCE_THEME=catppuccin_mocha gh enhance --run {1})+abort')
  if [[ -n "$pick" ]]; then
    local run_id
    run_id=$(printf '%s' "$pick" | cut -f1)
    ENHANCE_THEME=catppuccin_mocha gh enhance --run "$run_id"
  fi
}

