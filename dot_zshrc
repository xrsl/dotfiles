# mmv (mermaid view) — render a .mmd to a temp PNG and show it inline in the terminal.
# Dark theme + transparent bg so it reads on a dark terminal; needs `mmdc` and `chafa`.
mmv() {
  if [ -z "$1" ]; then echo "usage: mmv <file.mmd>" >&2; return 1; fi
  local out="${TMPDIR:-/tmp}/_mmv.png"
  mmdc -i "$1" -o "$out" -t dark -b '#1e1e2e' -s 3 && viu "$out"
}

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

# Widget plugins (profile "post"): fzf-tab, autosuggestions, you-should-use, then
# syntax-highlighting LAST — all load after compinit and all widgets/bindings.
# (fpath plugins like zsh-completions load earlier via `--profile pre`.)
# sheldon is installed by mise, so this is identical on macOS and Linux.
# Config: ~/.config/sheldon/plugins.toml
command -v sheldon >/dev/null 2>&1 && eval "$(sheldon --profile post source)"
