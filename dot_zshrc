# ── STARSHIP ──────────────────────────────────────────────────────────────────
# Config: ~/.config/starship.toml — see https://starship.rs/presets/

# ── PATH ──────────────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"
export CDPATH=".:$HOME/ghub"

[[ -f ~/.profile ]] && source ~/.profile

[[ -d "$HOME/.opencode/bin" ]] && export PATH="$HOME/.opencode/bin:$PATH"
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"


if command -v go &>/dev/null; then
  export GOBIN="$(go env GOPATH)/bin"
  export PATH="$PATH:$GOBIN"
fi

eval "$(starship init zsh)"

# ── AUTOSUGGESTIONS ───────────────────────────────────────────────────────────
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#663399,standout"
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE="20"
ZSH_AUTOSUGGEST_USE_ASYNC=1

if command -v brew &>/dev/null; then
  [[ -f "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
    source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [[ -f "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
    source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# ── ALIASES ───────────────────────────────────────────────────────────────────
alias cls='clear'
alias ls='eza --icons '
alias lz='eza -TL 1 --icons -a'
alias zshconfig='chezmoi edit ~/.zshrc'

jd() { JUST_JUSTFILE=$HOME/ghub/data/justfile JUST_WORKING_DIRECTORY="$PWD" just "$@"; }

# ── TOOLS ─────────────────────────────────────────────────────────────────────
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && source "$NVM_DIR/bash_completion"

command -v fnm &>/dev/null && eval "$(fnm env)"
eval "$(atuin init zsh)"

if [[ -d "$HOME/.docker/completions" ]]; then
  fpath=("$HOME/.docker/completions" $fpath)
  autoload -Uz compinit && compinit
fi

# ── TERMINAL ──────────────────────────────────────────────────────────────────
# Reset cursor to steady bar before every prompt (counteracts vim/nvim block cursor)
precmd_cursor() { printf '\e[6 q'; }
precmd_functions+=(precmd_cursor)

# Fix delete/backspace for remote terminals
bindkey "^[[3~" delete-char
bindkey "^?" backward-delete-char

# Kiro IDE shell integration
[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"

# ── ENV ───────────────────────────────────────────────────────────────────────
[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
[[ -f "$HOME/.atuin/bin/env" ]] && source "$HOME/.atuin/bin/env"

 
# worktrunk
autoload -Uz compinit && compinit
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

fpath+=~/.zfunc; autoload -Uz compinit; compinit

zstyle ':completion:*' menu select

# Just
alias j=just
alias .j='just --justfile ~/.justfile --working-directory .'
fpath=(~/.zsh/completions $fpath)
autoload -U compinit
compinit

# lean-ctx
export LEAN_CTX_SHELL_ACTIVATION=agents-only
eval "$(lean-ctx init zsh)"

# >>> lean-ctx agent aliases >>>
alias claude='LEAN_CTX_AGENT=1 BASH_ENV="$HOME/.bashenv" claude'
alias codex='LEAN_CTX_AGENT=1 BASH_ENV="$HOME/.bashenv" codex'
alias gemini='LEAN_CTX_AGENT=1 BASH_ENV="$HOME/.bashenv" gemini'
# <<< lean-ctx agent aliases <<<

# >>> lean-ctx proxy env >>>
export GEMINI_API_BASE_URL="http://127.0.0.1:4444"
# <<< lean-ctx proxy env <<<

# opencode
export PATH=/Users/resulal/.opencode/bin:$PATH


# Added by Antigravity CLI installer
export PATH="/Users/resulal/.local/bin:$PATH"

# Agents
alias cc='claude --dangerously-skip-permissions'
alias cx='codex --yolo'


# Worktrunk
# wts() { wt switch -x 'code .' "$@"; }
wts() { local _cwd="$PWD"; wt switch -x 'code .' "$@"; cd "$_cwd"; }
wtl() { wt list; }

# VSCode
vsc() { code . }