# Worktrunk: s/l/r/c/pr live in ~/.config/worktrunk/config.toml [aliases]
# (switch/remove cd propagates from aliases via shell integration).
# wtcode stays a function: its `cd` back to the original dir can't persist from an alias.
alias wtl='wt l'         # fast (~0.6s): local status only
alias wtlf='wt l --full' # full (~11s cold): + CI status & LLM summaries (network/LLM, cached 30-60s)
alias wtlr='wt l --remotes'
alias wtd='wt d'         # 'wt step diff': all changes since branching (committed+staged+unstaged+untracked)
alias wts='wt s'
# wtn <branch> [<base>]: 'wt new'. Optional 2nd positional is the base ref
# (main, origin/main, @; '.' is rewritten to @). Defaults to origin/main.
wtn() {
  local branch base
  local -a rest
  (( $# )) && { branch="$1"; shift; }
  (( $# )) && [[ "$1" != -* ]] && { base="$1"; shift; }
  rest=("$@")
  [[ "$base" == "." ]] && base="@"
  if [[ -n "$base" ]]; then
    # 'new' alias takes base as a positional (args[1]) and adds --base itself;
    # passing --base here would double up into `--base --base`.
    wt new "$branch" "$base" "${rest[@]}"
  elif [[ -n "$branch" ]]; then
    wt new "$branch" "${rest[@]}"
  else
    wt new
  fi
}
# wtc [cx|co|oc|pi] — commit with LLM-generated message.
#   wtc          → claude (default backend, 'wt sc'); forwards extra args to step commit
#   wtc cx       → codex     (wt sc-cx)
#   wtc pi       → local qwen (wt sc-pi) — never rate-limited; use when claude is exhausted
#   wtc oc / co  → opencode / copilot (wt sc-oc / sc-co)
wtc() {
  case "$1" in
    cx|co|oc|pi) wt "sc-$1" ;;
    *)           wt sc "$@" ;;
  esac
}
# wtcp [cx|pi] — commit+push. Default = claude (wt scp); cx = codex, pi = local qwen.
# Only cx/pi have push variants (scp-cx/scp-pi); oc/co are commit-only via wtc.
wtcp() {
  case "$1" in
    cx|pi) wt "scp-$1" ;;
    *)     wt scp "$@" ;;
  esac
}
