# Just
alias j=just
# A function, not an alias: just's completion is clap-dynamic, and passing
# --justfile/--working-directory on the command line makes it stop treating the
# positional as a recipe and fall back to path completion, which is why
# `.j llm::<TAB>` offered directories. The env vars do the same job invisibly,
# leaving a bare `just` for the completer to read. compdef because a function,
# unlike an alias, does not inherit just's completion.
.j() { JUST_JUSTFILE="$HOME/.justfile" JUST_WORKING_DIRECTORY="$PWD" just "$@"; }
compdef _just .j

