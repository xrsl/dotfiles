# Order matters: environment → tools → completions (one compinit) → keys & hooks →
# functions → aliases → sheldon widget plugins last.
# Multi-line functions live one per file in ~/.config/zsh/functions (autoloaded below).

# ── ENVIRONMENT & PATH ────────────────────────────────────────────────────────

# Keep optional Nix environment setup here so Zsh has a single profile entrypoint.
if [[ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ]]; then
  source "$HOME/.nix-profile/etc/profile.d/nix.sh"
fi

# Keep PATH unique and finish all manual PATH changes before mise activation.
typeset -U path PATH
path=(
  "$HOME/.local/bin"
  "$HOME/go/bin"
  $path
)
export CDPATH=".:$HOME/ghub"

export EDITOR=fresh
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/catppuccin-mocha.yml"
# Copilot CLI only emits token usage via OTel file export; tokscale reads ~/.copilot/otel
export COPILOT_OTEL_FILE_EXPORTER_PATH="$HOME/.copilot/otel/usage.jsonl"

# fzf: styled like the snacks.nvim picker in Catppuccin Mocha. Previews use bat,
# whose theme is set in ~/.config/bat/config.
#   Ctrl-T  pick files and insert their paths    Alt-C  cd into a picked dir
#   Ctrl-R  stays with atuin
export FZF_DEFAULT_COMMAND='fd -t f -H -E .git'
export FZF_DEFAULT_OPTS="--style=full --layout=reverse --height=90% --border=none \
  --prompt=' ' --pointer='▌' --marker='┃' --info=inline-right \
  --preview-window=right,65%,border-rounded --bind='ctrl-/:toggle-preview' \
  --color=bg+:#313244,bg:#1e1e2e,fg:#cdd6f4,fg+:#cdd6f4,hl:#89b4fa,hl+:#89b4fa \
  --color=selected-bg:#45475a,border:#89b4fa,label:#cdd6f4,prompt:#89b4fa \
  --color=pointer:#f5e0dc,marker:#b4befe,spinner:#f5e0dc,info:#6c7086,header:#f38ba8 \
  --color=input-border:#89b4fa,list-border:#45475a,preview-border:#45475a"
export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
export FZF_CTRL_T_OPTS="--multi --input-label ' Files ' \
  --preview 'bat --color=always --style=numbers -r :500 {}'"
export FZF_ALT_C_COMMAND='fd -t d -H -E .git'
export FZF_ALT_C_OPTS="--input-label ' Dirs ' --preview 'eza -T -L2 --color=always {} 2>/dev/null || ls {}'"
export FZF_CTRL_R_COMMAND=   # empty value: fzf leaves Ctrl-R to atuin

# Autosuggestions (the plugin itself is loaded last, via sheldon)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#663399,standout"
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE="20"
ZSH_AUTOSUGGEST_USE_ASYNC=1

# ── TOOLS ─────────────────────────────────────────────────────────────────────

# mise owns developer runtimes and CLI tools.
# Stub so mise's `$+functions[compdef]` guard skips its early compinit; the real compinit below redefines it.
compdef() { :; }
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"

# Nested shells may inherit paths from installers that mise replaced.
for stale_path in \
  "$HOME/.opencode/bin" \
  "$HOME/.bun/bin" \
  "$HOME/.atuin/bin" \
  /Library/Frameworks/Python.framework/Versions/3.12/bin; do
  path=("${(@)path:#${stale_path}}")
done
unset stale_path

# Config: ~/.config/starship.toml — see https://starship.rs/presets/
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh)"
command -v fzf >/dev/null && source <(fzf --zsh)

# ── COMPLETIONS ───────────────────────────────────────────────────────────────
# All fpath additions must happen before the single compinit below.
if [[ -d "$HOME/.docker/completions" ]]; then
  fpath=("$HOME/.docker/completions" $fpath)
fi
fpath+=~/.zfunc
fpath=(~/.zsh/completions $fpath)

# Generated completions, regenerated only when the binary is newer than the file (like wt below).
# A new file needs a full compinit (-C skips the new-file check), so drop the dump.
typeset -A _gen_comp=(mise 'mise completion zsh' uv 'uv generate-shell-completion zsh')
for _c _cmd in ${(kv)_gen_comp}; do
  (( $+commands[$_c] )) || continue
  [[ ~/.zfunc/_$_c -nt =$_c ]] && continue
  mkdir -p ~/.zfunc && eval $_cmd >| ~/.zfunc/_$_c && rm -f ~/.zcompdump
done
unset _gen_comp _c _cmd

# fpath/completion plugins (e.g. zsh-completions) must reach fpath before compinit.
command -v sheldon >/dev/null 2>&1 && eval "$(sheldon --profile pre source)"

# One compinit; skip the security audit (compaudit) when the dump is < 24h old.
# -C also skips the new-file check: after adding a completion, rm ~/.zcompdump.
# (Array, not [[ -n … ]]: [[ ]] never globs, so that test was always true.)
autoload -Uz compinit
_zcd=(~/.zcompdump(Nmh+24))
if (( $#_zcd )) || [[ ! -s ~/.zcompdump ]]; then
  compinit
  touch ~/.zcompdump  # compinit only rewrites the dump when files change; restart the 24h clock
else
  compinit -C
fi
unset _zcd

zstyle ':completion:*' menu select

# worktrunk (uses compdef, so must run after compinit)
if command -v wt >/dev/null 2>&1; then
  # Cached: regenerated only when the wt binary is newer than the cache.
  _wt_init=${XDG_CACHE_HOME:-$HOME/.cache}/wt-init.zsh
  [[ $_wt_init -nt =wt ]] || command wt config shell init zsh >| $_wt_init
  source $_wt_init
  unset _wt_init
fi

# zoxide (smarter cd) — after atuin so keybindings stay intact, after compinit for its compdef
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# ── KEYS & HOOKS ──────────────────────────────────────────────────────────────

# atuin: Up searches history; Down clears a line Up filled instead of stepping history.
_atuin_up_search_marked() {
  zle atuin-up-search
  [[ -n "$BUFFER" ]] && _ATUIN_SELECTED_BUFFER=1
}

_atuin_up_search_viins_marked() {
  zle atuin-up-search-viins
  [[ -n "$BUFFER" ]] && _ATUIN_SELECTED_BUFFER=1
}

_atuin_up_search_vicmd_marked() {
  zle atuin-up-search-vicmd
  [[ -n "$BUFFER" ]] && _ATUIN_SELECTED_BUFFER=1
}

_atuin_down_clear_selected() {
  if [[ -n "${_ATUIN_SELECTED_BUFFER:-}" && -n "$BUFFER" ]]; then
    BUFFER=""
    CURSOR=0
    unset _ATUIN_SELECTED_BUFFER
    zle reset-prompt
  else
    zle down-line-or-history
  fi
}

zle -N atuin-up-search-marked _atuin_up_search_marked
zle -N atuin-up-search-viins-marked _atuin_up_search_viins_marked
zle -N atuin-up-search-vicmd-marked _atuin_up_search_vicmd_marked
zle -N atuin-down-clear-selected _atuin_down_clear_selected

bindkey -M emacs '^[[A' atuin-up-search-marked
bindkey -M emacs '^[OA' atuin-up-search-marked
bindkey -M viins '^[[A' atuin-up-search-viins-marked
bindkey -M viins '^[OA' atuin-up-search-viins-marked
bindkey -M vicmd '^[[A' atuin-up-search-vicmd-marked
bindkey -M vicmd '^[OA' atuin-up-search-vicmd-marked
bindkey -M emacs '^[[B' atuin-down-clear-selected
bindkey -M emacs '^[OB' atuin-down-clear-selected
bindkey -M viins '^[[B' atuin-down-clear-selected
bindkey -M viins '^[OB' atuin-down-clear-selected
bindkey -M vicmd '^[[B' atuin-down-clear-selected
bindkey -M vicmd '^[OB' atuin-down-clear-selected

# Fix delete/backspace for remote terminals
bindkey "^[[3~" delete-char
bindkey "^?" backward-delete-char
bindkey "^U" backward-kill-line

copy-current-line() {
  print -rn -- "$BUFFER" | pbcopy
}
zle -N copy-current-line
bindkey "^G" copy-current-line
bindkey "^X^C" copy-current-line

# Reset cursor to steady bar before every prompt (counteracts vim/nvim block cursor)
precmd_cursor() { printf '\e[6 q'; }
precmd_functions+=(precmd_cursor)

# herdr: rename the current tab to the current git branch (repo name if on the default branch);
# outside a repo, the dir name (~ for home) instead of herdr's numeric default
_herdr_last_tab_label=""
precmd_herdr_tab_branch() {
  [[ -n "$HERDR_TAB_ID" ]] || return
  local branch label
  if ! branch=$(git branch --show-current 2>/dev/null); then
    label=${${(D)PWD}:t}
    [[ "$label" != "$_herdr_last_tab_label" ]] || return
    herdr tab rename "$HERDR_TAB_ID" "$label" &>/dev/null
    _herdr_last_tab_label="$label"
    return
  fi
  [[ -n "$branch" ]] || return

  local default_branch
  default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  default_branch=${default_branch#origin/}
  if [[ -z "$default_branch" ]]; then
    for c in main master; do
      git show-ref --quiet --verify "refs/heads/$c" 2>/dev/null && { default_branch=$c; break; }
    done
  fi

  if [[ -n "$default_branch" && "$branch" == "$default_branch" ]]; then
    local common_dir
    common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
    label=$(basename "$(dirname "$common_dir")")
  else
    label="$branch"
  fi

  [[ "$label" != "$_herdr_last_tab_label" ]] || return
  herdr tab rename "$HERDR_TAB_ID" "$label" &>/dev/null
  _herdr_last_tab_label="$label"
}
precmd_functions+=(precmd_herdr_tab_branch)

# ── FUNCTIONS ─────────────────────────────────────────────────────────────────
# One file per function, loaded on first call; each file starts with its usage notes.
#   VMs & hosts   vmu vmd rh
#   git & review  h hl hpr eh
#   editors       vsc
#   GitHub        pr
#   worktrunk     wtn wtc wtcp
#   mise & just   m mx ml mq
#   1Password     opil opig opic opis opid
#   work API      org_id org_slug
#   misc          nvimtheme
fpath=(~/.config/zsh/functions $fpath)
autoload -Uz ~/.config/zsh/functions/*(.:t)

# ── ALIASES ─────────────────────────────────────────────────────────────────

# Shell & files
alias cls='clear'
alias ls='eza --icons=auto'  # =auto: a bare --icons swallows the next arg (ls <dir> broke)
alias lz='eza -TL 1 --icons -a'
alias b='bat'
alias f="spf"
alias y=yazi
alias tb="terminal-browser open"
alias vml="tart list --source local"  # tart VMs (macOS); vmu/vmd are functions
alias sshkill='pkill -u $USER sshd'  # on a VM/server: drop your ssh connections (herdr keeps running); then rh <host>
# tokens today / this week
alias tt="python3 ~/.config/tokscale/cline-cli-bridge.py >/dev/null 2>&1; tokscale --today"
alias tw="python3 ~/.config/tokscale/cline-cli-bridge.py >/dev/null 2>&1; tokscale --week"

# Editors
alias e='fresh --no-restore'  # just the named file(s): any flag skips orchestrator mode
alias v="nvim"

# Git
alias g="lazygit"
alias gs="git status -sb"
alias p="git pull --ff-only" gp="git pull --ff-only"
alias P="git push" gP="git push"
# discard everything since the last commit
alias gd='git reset --hard HEAD && git clean -fd'
# discard staged + unstaged changes for given paths (file or dir/), back to HEAD
alias gr='git restore --source=HEAD --staged --worktree --'
# list tags newest-first by creation date, with date + annotation subject
alias gtl="git tag --sort=-creatordate --format='%(color:yellow)%(refname:short)%(color:reset)  %(color:green)%(creatordate:short)%(color:reset)  %(contents:subject)'"
# list branches (local + remote) newest-first, with date, upstream and subject
alias gbl="git for-each-ref --exclude='refs/remotes/*/HEAD' --sort=-committerdate refs/heads refs/remotes --format='%(color:red)%(HEAD)%(color:reset) %(color:yellow)%(align:width=40,position=left)%(refname:short)%(end)%(color:reset) %(color:green)%(committerdate:short)%(color:reset)  %(color:blue)%(align:width=14,position=left)%(upstream:short)%(end)%(color:reset) %(contents:subject)'"
# lazygit-style commit list: graph, sha, author, relative time, refs, subject
alias gcl="git log --graph --decorate --format='%C(yellow)%h %C(blue)%<(14,trunc)%an %C(magenta)%<(12,trunc)%ar%C(auto)%d %C(reset)%s'"

# GitHub
alias ghr="gh repo view --web"  # open current repo in browser

# Agents
alias cc='claude --dangerously-skip-permissions'
alias ccc='claude -c --dangerously-skip-permissions'
alias ccr='claude -r --dangerously-skip-permissions'
alias cx='codex --yolo'
alias cxc='codex --yolo resume'
alias co='copilot --autopilot --allow-all-tools'
alias coc='copilot --autopilot --allow-all-tools --resume'
alias oc='OPENCODE_PERMISSION="{\"*\":\"allow\"}" opencode'
alias cr="crush --yolo"
alias crc="crush --yolo --continue"
alias kl="kilo --auto"
alias klc="kilo --auto --continue"
alias klm="kilo --auto --mini"
alias ca="cursor-agent --yolo"
alias cac="cursor-agent --yolo --continue"
alias car="cursor-agent --yolo --resume"

# Worktrunk: multi-step aliases (newtree/sc/scp/pr/land/up/home/wip/rev) live in
# ~/.config/worktrunk/config.toml; switch/remove cd propagates via shell integration.
alias wts='wt switch'
alias wtl='wt list'              # fast (~0.6s): local status only
alias wtlf='wt list --full'      # + CI status & LLM summaries (~11s cold, cached)
alias wtlr='wt list --remotes'
alias wtd='wt step diff'         # all changes since branching (committed+staged+unstaged+untracked)
alias wtrm='wt remove -D'        # removes worktree AND force-deletes the branch (even unmerged)
alias wth='wt home'

# mise & just
alias j=just
# -g is just's own global-justfile flag: it resolves ~/.justfile, runs recipes in
# the invocation directory, and unlike an explicit --justfile leaves the completer
# able to see the positional as a recipe.
alias .j='just -g'
compdef m=mise  # m is in functions/
alias kp='killport --no-fail'

# ── PLUGINS ───────────────────────────────────────────────────────────────────
# Widget plugins (profile "post"): fzf-tab, autosuggestions, you-should-use, then
# syntax-highlighting LAST — all load after compinit and all widgets/bindings.
# (fpath plugins like zsh-completions load earlier via `--profile pre`.)
# sheldon is installed by mise, so this is identical on macOS and Linux.
# Config: ~/.config/sheldon/plugins.toml
command -v sheldon >/dev/null 2>&1 && eval "$(sheldon --profile post source)"
