# org_id / org_slug — translate between Modeling Platform (staging) org slugs and IDs.
#   org_id acme-corp   -> 42
#   org_slug 42        -> acme-corp
# Token is read from ~/.config/mpcli/.env (MP_API_STG_TOKEN) so it is never stored here.
_mp_stg_token() {
  local tok=${MP_API_STG_TOKEN:-$(grep -m1 '^MP_API_STG_TOKEN=' ~/.config/mpcli/.env 2>/dev/null | cut -d= -f2-)}
  if [ -z "$tok" ]; then
    echo "${funcstack[2]:-mp}: no MP_API_STG_TOKEN (env or ~/.config/mpcli/.env)" >&2
    return 1
  fi
  print -r -- "$tok"
}

# org_id <slug> — the API has GET /organizations/:organization-slug, so this is one call.
org_id() {
  if [ -z "$1" ]; then echo "usage: org_id <org-slug>" >&2; return 1; fi
  local tok; tok=$(_mp_stg_token) || return 1
  curl -fsS -H "APIApplicationUser: $tok" \
    "https://api.modeling.staging.bw7.io/api/organizations/$1" | jq -e '.ID'
}

# org_slug <id> — the reverse has no endpoint: routes/main.go only exposes GetBySlug,
# never GetByID. So list every org the token can see and match on ID client-side.
# An ID outside the token's visibility reads as "not found", not as an error.
org_slug() {
  if [ -z "$1" ]; then echo "usage: org_slug <org-id>" >&2; return 1; fi
  if [[ $1 != <-> ]]; then echo "org_slug: <org-id> must be a number, got '$1'" >&2; return 1; fi
  local tok; tok=$(_mp_stg_token) || return 1
  curl -fsS -H "APIApplicationUser: $tok" \
    "https://api.modeling.staging.bw7.io/api/organizations" \
    | jq -re --argjson id "$1" 'map(select(.ID == $id)) | .[0].Slug // empty' \
    || { echo "org_slug: no organization with ID $1 visible to this token" >&2; return 1; }
}

# nvimtheme — install and pin a Neovim colorscheme (themes from vimcolorschemes.com).
#   nvimtheme rebelot/kanagawa.nvim        install, pin "kanagawa"
#   nvimtheme rose-pine/neovim rose-pine   when the repo name != the colorscheme name
#   nvimtheme tokyonight-moon              pin something already installed
#   nvimtheme                              print what is pinned
# Edits the chezmoi source of lua/plugins/colorscheme.lua via its nvimtheme: markers.
nvimtheme() {
  local src=~/.local/share/chezmoi/private_dot_config/nvim/lua/plugins/colorscheme.lua
  local dst=~/.config/nvim/lua/plugins/colorscheme.lua
  local arg=$1 name=$2

  if [ -z "$arg" ]; then
    perl -ne 'print "$1\n" if /^local theme = "(.*?)"/' $src
    return
  fi

  if [[ $arg == */* ]]; then
    : ${name:=${${arg:t}%%.*}}
    grep -q "\"$arg\"" $src ||
      perl -pi -e "s|^( *)(-- nvimtheme:end)|\${1}{ \"$arg\", lazy = true },\n\${1}\$2|" $src
    chezmoi apply $dst && nvim --headless '+Lazy! sync' +qa
  else
    : ${name:=$arg}
  fi

  # verify before pinning: a bad name means every launch falls back to habamax with an error
  if ! nvim --headless "+lua os.exit(pcall(vim.cmd.colorscheme, '$name') and 0 or 1)" >/dev/null 2>&1; then
    echo "nvimtheme: '$name' did not load. Plugin is installed; pass the colorscheme name as arg 2, or browse with <leader>uC." >&2
    return 1
  fi

  perl -pi -e "s/^local theme = \".*?\"/local theme = \"$name\"/" $src
  chezmoi apply $dst && echo "pinned $name"
}

