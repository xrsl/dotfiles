set quiet := true
set unstable := true
set dotenv-load := true
set script-interpreter := ['uv', 'run', '--script']

export UV_SYSTEM_CERTS := "true"


mod? ado '~/ghub/ado/justfile'
mod? aws '~/ghub/aws/justfile'
mod? docker '~/ghub/docker/justfile'
mod? llm '~/ghub/llm/justfile'
mod? pi '~/ghub/llm/.just/pi.just'
mod? oc '~/ghub/llm/.just/oc.just'

set shell := ["zsh", "-cu"]

_default:
    just --justfile {{ justfile() }} --list --unsorted


uv *args:
    uv {{ args }}

uvx *args:
    uvx {{ args }}

# add/rm re-add the config to chezmoi, whose autoPush ships it to every machine.
[doc("add tool… [mac|linux|linux/x64] → global use (OS args → os=[…]) · rm tool… → remove everywhere, no leftovers · clean → prune + dedup + dead dirs · sync → pull dotfiles, install, then strip what config no longer wants (stale lock, os-gated installs) + clean · else passthrough")]
[positional-arguments]
[script('zsh')]
mise *args:
    set -euo pipefail
    cmd=${1:-}; (( $# )) && shift
    case $cmd in
      add|rm|remove|unuse|clean|sync) ;;
      *) exec mise $cmd "$@" ;;
    esac
    [[ $cmd == (clean|sync) ]] || (( $# )) || { echo "usage: j mise $cmd tool…" >&2; exit 1; }
    data=${MISE_DATA_DIR:-$HOME/.local/share/mise} cfg=$HOME/.config/mise/config.toml lock=$HOME/.config/mise/mise.lock
    here=${${(L)$(uname -s)}/darwin/macos} arch=$(uname -m); arch=${${arch/x86_64/x64}/aarch64/arm64}
    # os list ($@) leaves this machine out
    skips() { (( ${argv[(Ie)$here]} + ${argv[(Ie)$here/$arch]} == 0 )) }
    # uninstall all versions + cache; uninstall alone leaves the tool dir with dangling `2 -> 2.0.0` links and an empty downloads dir
    purge() {
      local dirs=(${(f)"$(mise ls --json --installed $1 2>/dev/null | jq -r '.[].install_path' | xargs -rn1 dirname | sort -u)"}) d real
      mise uninstall --all $1 >/dev/null 2>&1 || true
      mise cache clear $1 >/dev/null 2>&1 || true
      for d in $dirs; do real=($d/*(N-/)); (( $#real )) || rm -rf $d $data/downloads/${d:t}; done
    }
    # drop the tools' [[tools."T"]] / [[tools.T]] / [tools.T.…] blocks; `mise lock -g` would too but re-resolves every tool for every platform (~40s)
    unlock() {
      [[ -f $lock ]] || return 0
      awk -v t="$*" 'BEGIN { split(t, a, " "); for (i in a) drop[a[i]] }
        /^\[/ { n = $0; sub(/^\[+tools\./, "", n); if (sub(/^"/, "", n)) sub(/".*/, "", n); else sub(/[].].*/, "", n); skip = n in drop }
        !skip' $lock > $lock.tmp && mv $lock.tmp $lock
    }
    if [[ $cmd == sync ]]; then
      chezmoi update  # config.toml as the other machines left it
      # the lock is per machine (chezmoiignore'd): tools removed elsewhere stay pinned in it, and `mise prune` then keeps them
      keep=(${(f)"$(yq -p toml -o tsv '.tools | keys | .[]' $cfg)"})
      stale=(${(f)"$([[ -f $lock ]] && sed -nE 's/^\[\[tools\."?([^]"]+).*/\1/p' $lock | sort -u)"})
      stale=(${stale:|keep})
      (( $#stale )) && { echo "unlock $stale"; unlock $stale; }
      # os-gated tools installed here anyway (`mise use` ignores os); `mise prune` counts them as used. Keep what a project config pins.
      installed=(${(f)"$(mise ls --installed --json | jq -r 'keys[]')"})
      projects=(${${(f)"$(print -l ~/.local/state/mise/tracked-configs/*(N@:A))"}:#$cfg})
      for e in ${(f)"$(yq -p toml -o tsv '.tools | to_entries | .[] | select(.value.os) | .key + " " + (.value.os | join(" "))' $cfg)"}; do
        t=${e%% *}
        (( ${installed[(Ie)$t]} )) && skips ${=e#* } || continue
        grep -qsE "^\"?$t\"?[[:space:]]*=|^$t " $projects && continue
        purge $t; echo "purged $t (os-gated)"
      done
      mise install
      cmd=clean
    fi
    if [[ $cmd == clean ]]; then
      mise prune -y
      # same version installed twice (e.g. 8.0.1 and 8.0.1~uv~<hash> after an installer switch): keep the active path.
      # Only tools with an active entry here, so os-gated and project-only tools are untouched.
      mise ls --json | jq -r '.[] | (map(select(.source)) | map(.install_path)) as $keep
        | select($keep | length > 0) | map(select(.installed and .source == null) | .install_path) - $keep | .[]' |
        while read -r p; do echo "dedup ${p#$data/installs/}"; rm -rf $p; done
      for d in $data/installs/*(N/); do real=($d/*(N-/)); (( $#real )) || { echo "dead ${d:t}"; rm -rf $d $data/downloads/${d:t}; }; done
      rm -rf $data/downloads/*(N/^F)
      mise reshim || true
      exit
    elif [[ $cmd == add ]]; then
      tools=() os=()
      for a; do case $a in mac) os+=macos ;; macos|macos/*|linux|linux/*) os+=$a ;; *) tools+=$a ;; esac; done
      opt=(); (( $#os )) && opt=(--tool-option "os=[\"${(j:",":)os}\"]")
      mise use -g $opt $tools
      # mise use installs even when os excludes this machine
      if (( $#os )) && skips $os; then
        for t in $tools; do purge $t; done
      fi
    else
      for t; do
        [[ ${t##*/} != *@* ]] || { echo "$t: pass tool names only, no @version" >&2; exit 1; }
        mise unuse -g --no-prune $t 2>/dev/null || echo "$t: not in global config"
        purge $t
        unlock $t
        echo "removed $t"
      done
    fi
    chezmoi re-add ~/.config/mise/config.toml
    mise reshim || true  # panics on some mise versions; harmless to skip
	
	
buzz *args:
    buzz {{ args }}	
	
# j gh-to-buzz owner/repo → private channel + unlisted repo + unlisted project
gh-to-buzz slug:
    #!/usr/bin/env zsh
    set -euo pipefail
    s={{ slug }}; id=${s#*/}
    d=$(gh repo view {{ slug }} --json description -q .description)
    ch=$(buzz channels create --name $id --type stream --visibility private | jq -er .channel_id)
    buzz repos create --id $id --name $id --clone https://github.com/{{ slug }}.git --web https://github.com/{{ slug }} ${d:+--description=$d} --channel $ch | jq -r .link
    buzz projects create $id --repo $id --name $id ${d:+--description=$d} --channel $ch --visibility unlisted | jq -r .link
    git clone https://github.com/{{ slug }}.git ~/.buzz/REPOS/$id
