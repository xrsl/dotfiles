[git]
    autoCommit = true
    autoPush = true

[data]
    bedrockRegion = {{ promptStringOnce . "bedrockRegion" "Bedrock region" | quote }}
    bedrockProfile = {{ promptStringOnce . "bedrockProfile" "AWS SSO profile for Bedrock" | quote }}
