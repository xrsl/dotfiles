    bedrockSonnet = {{ promptStringOnce . "bedrockSonnet" "Bedrock Sonnet inference profile ID" | quote }}
    bedrockOpus = {{ promptStringOnce . "bedrockOpus" "Bedrock Opus inference profile ID" | quote }}
    bedrockHaiku = {{ promptStringOnce . "bedrockHaiku" "Bedrock Haiku inference profile ID" | quote }}
