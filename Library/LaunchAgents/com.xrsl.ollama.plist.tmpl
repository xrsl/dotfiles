<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xrsl.ollama</string>
  <!-- mise x resolves the current ollama, so an upgrade applies on the next restart -->
  <key>ProgramArguments</key>
  <array>
    <string>{{ lookPath "mise" | default (joinPath .chezmoi.homeDir ".local/bin/mise") }}</string>
    <string>x</string>
    <string>--</string>
    <string>ollama</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- 64k context for every model. Measured cost: +0.8 GB for qwen3.6:35b, +1.5 GB
         for qwen3.5:4b, ~0 for qwen3.8:27b (hybrid attention keeps the KV cache small).
         pi's models.json contextWindow must match, or pi compacts at the old size. -->
    <key>OLLAMA_CONTEXT_LENGTH</key>
    <string>65536</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>{{ .chezmoi.homeDir }}</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/ollama.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/ollama.log</string>
</dict>
</plist>
