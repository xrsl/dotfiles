command_timeout = 2000

format = """
$hostname\
$directory\
$git_branch\
$git_status\
$line_break\
$character"""

right_format = "$cmd_duration"

# Machine tag, first thing on the prompt line; colors match _herdr_accent tabs.
# This Mac shows nothing. Linux boxes always show theirs; other Macs only over ssh.
{{- $h := .chezmoi.hostname }}
[hostname]
{{- if eq $h "ubuntu" }}
ssh_only = false
format = "[vm](bold #a6e3a1) "
{{- else if hasPrefix "vps-" $h }}
ssh_only = false
format = "[vps](bold #cba6f7) "
{{- else if eq .chezmoi.os "darwin" }}
format = "[$hostname](bold #fab387) "
{{- else }}
ssh_only = false
format = "[$hostname](bold #f38ba8) "
{{- end }}

[directory]
truncation_length = 3
truncate_to_repo = true

[git_branch]
format = "on [$symbol$branch]($style) "
symbol = "\uE0A0 "
style = "bold purple"

[git_status]
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
untracked = "?"
modified = "!"
staged = "+"
renamed = "»"
deleted = "✘"

[cmd_duration]
min_time = 10
format = "[$duration]($style)"
style = "dimmed white"
show_milliseconds = true

[python]
symbol = " "
format = "[$symbol$virtualenv]($style) "

[nodejs]
symbol = " "

[golang]
symbol = " "

[character]
success_symbol = "[→](green)"
error_symbol = "[→](red)"
