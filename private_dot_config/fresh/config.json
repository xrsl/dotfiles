{
  "theme": "catppuccin-mocha.json",
  "file_browser": {
    "show_hidden": true
  },
  "file_explorer": {
    "show_hidden": true,
    "show_gitignored": true,
    "width": "20%"
  },
  "active_keybinding_map": "vscode",
  "keybindings": [
    {
      "key": "escape",
      "action": "force_quit",
      "when": "normal"
    },
    {
      "key": "w",
      "modifiers": [
        "ctrl"
      ],
      "action": "close_tab",
      "when": "normal"
    },
    {
      "key": "j",
      "modifiers": [
        "ctrl"
      ],
      "action": "open_terminal",
      "when": "normal"
    }
  ]
}