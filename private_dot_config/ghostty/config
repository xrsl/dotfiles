theme = Catppuccin Mocha
background-opacity = 1
font-size = 15
window-save-state = always
font-family = JetBrainsMono Nerd Font Mono
copy-on-select = true
shell-integration-features = ssh-env,ssh-terminfo
split-preserve-zoom = navigation

keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+ctrl+right_bracket=goto_split:next
keybind = super+ctrl+left_bracket=goto_split:previous
keybind = super+ctrl+shift+equal=equalize_splits
# pass cmd+shift+[ / ] through to herdr (tab switching) instead of ghostty tabs
keybind = super+shift+left_bracket=unbind
keybind = super+shift+right_bracket=unbind
