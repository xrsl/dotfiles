theme = Catppuccin Mocha
background-opacity = 1
font-size = 15
window-save-state = always
font-family = JetBrainsMono Nerd Font Mono
copy-on-select = true
shell-integration-features = ssh-env,ssh-terminfo
split-preserve-zoom = navigation

keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+ctrl+right_bracket=goto_split:next
keybind = super+ctrl+left_bracket=goto_split:previous
keybind = super+ctrl+shift+equal=equalize_splits
# cmd+shift+[ / ] -> send ctrl+shift+left/right, herdr's previous/next tab (no kitty-protocol dependency)
keybind = super+shift+left_bracket=csi:1;6D
keybind = super+shift+right_bracket=csi:1;6C
