# style name or JSON path (default "auto"). Absolute path: glow v3.0.0 checks a ~ path but then opens it unexpanded and fails.
# catppuccin-mocha-mauve.json = catppuccin/glamour Mocha with h1 mauve #cba6f7, h2 blue #89b4fa, inline code bg #292c3c (Frappé).
style: "{{ .chezmoi.homeDir }}/.config/glow/catppuccin-mocha-mauve.json"
# mouse support (TUI-mode only)
mouse: true
# glow FILE opens the TUI (flowing paragraphs, live reload); gl is the pager path (ov, search). tui + pager together is an error.
pager: false
tui: true
# show all files, including hidden and ignored.
all: true
