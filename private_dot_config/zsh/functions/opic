# opic [-p] <ITEM> — copy an item's credential to the clipboard, printing nothing
# (Employee vault; -p for Private)
local label=Employee loc=(--account blackwoodseven.1password.eu --vault Employee)  # work
[[ "$1" == -p ]] && { label=Private loc=(--account my.1password.eu --vault Private); shift; }  # personal
if [ -z "$1" ]; then echo "usage: opic [-p] <item>" >&2; return 1; fi
op item get "$1" "${loc[@]}" --reveal --fields label=credential \
  | tr -d '\n' | pbcopy
