#compdef cz
# cz completes only its own shortcut surface (fzf-tab renders the descriptions); `cz diff` takes a path.
# Registered by `compdef` in .zshrc: this dir joins fpath after compinit, so #compdef is not read.
local -a sub=(
  's:chezmoi status (live vs source drift)'
  'p:pull remote → source → live (overwrites live)'
  'P:push live → source → remote (hunk review first)'
  'ls:list managed files as ~/ paths'
  'd:hunk diff, - live / + repo copy'
)
if (( CURRENT == 2 )); then
  _describe -t commands 'cz shortcut' sub
elif [[ $words[2] == (s|d) ]]; then
  _files
fi
