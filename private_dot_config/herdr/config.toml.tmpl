onboarding = false

[keys]
new_tab = "ctrl+shift+t" # avoids shadowing shell transpose-char / Fresh "Show All Symbols" in panes
close_tab = "prefix+q"  # prefix-isolated so ctrl+q passes through to Fresh / pane apps
close_pane = ["prefix+x", "ctrl+shift+x"]  # ctrl+shift+x mirrors prefix+x (close pane), no prefix needed
split_vertical = ["prefix+v", "ctrl+shift+n"]    # ctrl+shift+n mirrors prefix+v (split right), no prefix needed
split_horizontal = ["prefix+-", "ctrl+shift+m"]  # ctrl+shift+m mirrors prefix+- (split down), no prefix needed
detach = "prefix+d"     # leave Herdr while keeping its session and Tart VM running
previous_workspace = "ctrl+shift+up"     # jump to previous workspace
next_workspace = "ctrl+shift+down"       # jump to next workspace
previous_tab = "ctrl+shift+left"         # jump to previous tab
next_tab = "ctrl+shift+right"            # jump to next tab
cycle_pane_previous = ["prefix+shift+tab", "ctrl+shift+["]  # ctrl+shift+[ / ] cycle panes, no prefix
cycle_pane_next = ["prefix+tab", "ctrl+shift+]"]

[keys.indexed]
tabs = "ctrl"            # ctrl+1..9 jumps straight to a tab, no prefix
workspaces = "ctrl+shift"   # ctrl+shift+1..9 jumps straight to a workspace

[theme]
name = "catppuccin"
auto_switch = false

[ui]
prompt_new_tab_name = false   # create tabs immediately with the generated name, no prompt
agent_panel_sort = "priority" # moved here from a stray line under [[keys.command]] so it actually applies
show_agent_labels_on_pane_borders = true
# Accent paints the focused pane/tab highlight. This file is the host client.
# `hr` / `vmh` launch a separate client per machine and swap this color there
# (`_herdr_accent` in .zshrc): dev/vps = mauve, tahoe = pink, other VMs = green.
# These branches apply only when herdr is started on that machine itself.

{{- if ne .chezmoi.os "darwin" }}
accent = "#a6e3a1"   # catppuccin Green (soft green) — Linux VM guest (ubuntu)
{{- else if hasPrefix "VirtualMac" (output "sysctl" "-n" "hw.model" | trim) }}
accent = "#f5c2e7"   # catppuccin Pink (soft magenta) — macOS VM guest (tahoe)
{{- else }}
accent = "#89b4fa"   # catppuccin Blue — real hardware (host)
{{- end }}

[[keys.command]]              # open in a split beside your work
key = "prefix+f"
type = "shell"
command = "herdr plugin action invoke open-file-viewer --plugin herdr-file-viewer"

[[keys.command]]              # …or in its own tab
key = "prefix+shift+f"
type = "shell"
command = "herdr plugin action invoke open-file-viewer-tab --plugin herdr-file-viewer"

# Terminal annotations for herdr-annotate
[[keys.command]]
key = "prefix+a"
type = "plugin_action"
command = "annotate.capture"
description = "annotate text"

[[keys.command]]
key = "prefix+shift+a"
type = "plugin_action"
command = "annotate.copy-context"
description = "copy annotations as context"

[[keys.command]]
key = "prefix+ctrl+a"
type = "plugin_action"
command = "annotate.copy-archive"
description = "copy annotations as context and archive them"

[[keys.command]]
key = "prefix+m"
type = "plugin_action"
command = "annotate.manage"
description = "manage annotations"

# Document review (plannotator-tui)
[[keys.command]]
key = "prefix+o"
type = "plugin_action"
command = "annotate.open"
description = "review documents in this folder"

[[keys.command]]
key = "prefix+shift+o"
type = "plugin_action"
command = "annotate.last"
description = "review the agent's last reply"

[experimental]
kitty_graphics = true
