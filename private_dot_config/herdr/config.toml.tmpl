onboarding = false

[keys]
new_tab = "ctrl+t"      # NOTE: shadows shell transpose-char / Fresh "Show All Symbols" in panes
close_tab = "prefix+q"  # prefix-isolated so ctrl+q passes through to Fresh / pane apps
detach = "prefix+d"     # leave Herdr while keeping its session and Tart VM running
previous_workspace = "ctrl+shift+up"     # jump to previous workspace
next_workspace = "ctrl+shift+down"       # jump to next workspace
previous_tab = "ctrl+shift+left"         # jump to previous tab
next_tab = "ctrl+shift+right"            # jump to next tab

[keys.indexed]
tabs = "ctrl"            # ctrl+1..9 jumps straight to a tab, no prefix
workspaces = "ctrl+shift"   # ctrl+shift+1..9 jumps straight to a workspace

[theme]
name = "catppuccin"
auto_switch = false

[ui]
prompt_new_tab_name = false   # create tabs immediately with the generated name, no prompt
agent_panel_scope = "all"
agent_panel_sort = "priority" # moved here from a stray line under [[keys.command]] so it actually applies
show_agent_labels_on_pane_borders = true
# Accent paints the focused pane/tab highlight. Rendered per-machine by chezmoi at `apply` time:
# soft magenta on ANY Tart VM guest — Linux guests (os != darwin) or macOS guests
# (hw.model = VirtualMac*) — and blue on real hardware. Set once; covers every VM.
{{- if or (ne .chezmoi.os "darwin") (hasPrefix "VirtualMac" (output "sysctl" "-n" "hw.model" | trim)) }}
accent = "#f5c2e7"   # catppuccin Pink (soft magenta) — VM guest (Linux or macOS)
{{- else }}
accent = "#89b4fa"   # catppuccin Blue — real hardware (host)
{{- end }}

[[keys.command]]              # open in a split beside your work
key = "prefix+f"
type = "shell"
command = "herdr plugin action invoke open-file-viewer --plugin herdr-file-viewer"

[[keys.command]]              # …or in its own tab
key = "prefix+shift+f"
type = "shell"
command = "herdr plugin action invoke open-file-viewer-tab --plugin herdr-file-viewer"
