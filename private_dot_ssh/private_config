Include /Users/resulal/.colima/ssh_config

Host dev
    HostName 89.167.20.141
    User xrsl
    ForwardAgent yes
    IdentityFile ~/.ssh/id_ed25519

Host ubuntu
    User admin
    HostName ubuntu
    HostKeyAlias tart-ubuntu
    ProxyCommand /bin/sh -c 'exec /usr/bin/nc "$(/opt/homebrew/bin/tart ip ubuntu --wait 60)" %p'

Host tahoe
    User admin
    HostName tahoe
    HostKeyAlias tart-tahoe
    ProxyCommand /bin/sh -c 'exec /usr/bin/nc "$(/opt/homebrew/bin/tart ip tahoe-base --wait 60)" %p'

Host tart-*
    User admin
    ProxyCommand /bin/sh -c 'vm=${1#tart-}; exec /usr/bin/nc "$(/opt/homebrew/bin/tart ip "$vm" --wait 60)" %p' -- %n

Host ubuntu tahoe tart-*
    ForwardAgent yes

Match exec "test -S '%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
    IdentityAgent "%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
