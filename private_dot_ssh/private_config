Include config.local
Include ~/.colima/ssh_config

# omac over local Wi-Fi via mDNS. For away-from-home, switch HostName to Tailscale MagicDNS name.
Host omac
    HostName omac.local
    User resulal
    ForwardAgent yes

Host vm
    HostName ubuntu
    HostKeyAlias tart-ubuntu
    LocalForward 8090 127.0.0.1:8090   # harbor in the VM
    LocalForward 8092 127.0.0.1:8092
    LocalForward 19432 127.0.0.1:19432 # plannotator (remote mode over ssh uses this port)

# Any Tart VM: `ssh tart-<vm>`; `vm` is tart-ubuntu. %h is the HostName, minus tart-.
Host vm tart-*
    User admin
    ProxyCommand /bin/sh -c 'exec /usr/bin/nc "$("$HOME/.local/share/mise/shims/tart" ip "${1#tart-}" --wait 60)" %p' -- %h
    ForwardAgent yes
    # The Mac's managed firewall blocks all incoming connections, so a VM can't reach
    # host services; this outgoing session carries them instead.
    RemoteForward 8081 127.0.0.1:8081   # llama-server (opencode/pi baseURL)
    # Later sessions reuse the first one's connection and forwards: no tart ip lookup.
    # A VM rebooted under an open master: `ssh -O exit vm`.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m

Match exec "test -S '%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
    IdentityAgent "%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host *
    ServerAliveInterval 30
