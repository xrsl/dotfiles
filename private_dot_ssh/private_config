Include /Users/resulal/.colima/ssh_config

Host dev
    HostName 89.167.20.141
    User xrsl
    ForwardAgent yes
    IdentityFile ~/.ssh/id_ed25519

Host ubuntu
    User admin
    HostName ubuntu
    HostKeyAlias tart-ubuntu
    ProxyCommand /bin/sh -c 'exec /usr/bin/nc "$(/opt/homebrew/bin/tart ip ubuntu --wait 60)" %p'

Host tahoe
    User admin
    HostName tahoe
    HostKeyAlias tart-tahoe
    ProxyCommand /bin/sh -c 'exec /usr/bin/nc "$(/opt/homebrew/bin/tart ip tahoe-base --wait 60)" %p'
