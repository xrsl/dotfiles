Include config.local
Include /Users/resulal/.colima/ssh_config

Host ubuntu
    User admin
    HostName ubuntu
    HostKeyAlias tart-ubuntu
    ProxyCommand /bin/sh -c 'exec /usr/bin/nc "$(/Users/resulal/.local/share/mise/shims/tart ip ubuntu --wait 60)" %p'
    LocalForward 8090 127.0.0.1:8090
    LocalForward 8092 127.0.0.1:8092

Host tahoe
    User admin
    HostName tahoe
    HostKeyAlias tart-tahoe
    ProxyCommand /bin/sh -c 'exec /usr/bin/nc "$(/Users/resulal/.local/share/mise/shims/tart ip tahoe --wait 60)" %p'

Host tart-*
    User admin
    ProxyCommand /bin/sh -c 'vm=${1#tart-}; exec /usr/bin/nc "$(/Users/resulal/.local/share/mise/shims/tart ip "$vm" --wait 60)" %p' -- %n

Host ubuntu tahoe tart-*
    ForwardAgent yes

Match exec "test -S '%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
    IdentityAgent "%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
