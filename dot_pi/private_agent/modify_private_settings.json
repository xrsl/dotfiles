#!/bin/sh
# chezmoi modify_: pi rewrites settings.json itself (lastChangelogVersion on every
# upgrade), so a plain copy would drift on each run. Only the keys below are managed;
# chezmoi pipes the current file in and writes back the merge, keeping pi's own keys.
# Arrays replace rather than merge, so `packages` here is the whole extension list.
set -eu
current=$(cat)
[ -n "$current" ] || current='{}'
printf '%s\n' "$current" | jq --indent 2 '. * {
  "defaultProvider": "ollama",
  "defaultModel": "qwen3.6:35b",
  "defaultThinkingLevel": "medium",
  "theme": "dark",
  "packages": [
    "npm:@juanibiapina/pi-extension-settings",
    "npm:@plannotator/pi-extension",
    "npm:pi-subagents",
    "npm:pi-ask-user",
    "npm:pi-web-access",
    "git:github.com/VandeeFeng/pi-memory-md",
    "npm:pi-add-dir",
    "npm:pi-prompt-template-model",
    "npm:pi-claude-cli",
    "npm:@juanibiapina/pi-powerbar",
    "npm:@tmustier/pi-raw-paste",
    "git:github.com/tintinweb/pi-manage-todo-list@b75c449aa85ce328e9a8b632f62bf642aed40359",
    "npm:pi-btw",
    "git:github.com/davebcn87/pi-autoresearch",
    "npm:pi-terminal-theme",
    "git:github.com/DietrichGebert/ponytail"
  ],
  "subagents": {"agentOverrides": {
    "context-builder": {"model": ""}, "planner": {"model": ""}, "researcher": {"model": ""},
    "reviewer": {"model": ""}, "scout": {"model": ""}, "worker": {"model": ""}
  }}
}'
