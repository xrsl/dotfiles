{
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "{{ .chezmoi.homeDir }}/.claude/mods/context-bar"{{ if stat (joinPath .chezmoi.homeDir ".aws/ca-bundle.pem") }},
    "NODE_EXTRA_CA_CERTS": "{{ .chezmoi.homeDir }}/.aws/ca-bundle.pem",
    "SSL_CERT_FILE": "{{ .chezmoi.homeDir }}/.aws/ca-bundle.pem"{{ end }}
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_files",
      "mcp__codegraph__codegraph_status"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\"",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "superpowers@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "portal@portal": true,
    "shunt@portal": true,
    "ponytail@ponytail": true,
    "recast@synced": false,
    "liftroi@synced": false,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      },
      "autoUpdate": true
    },
    "recast": {
      "source": {
        "source": "github",
        "repo": "getrecast/recast-for-claude"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "liftroi": {
      "source": {
        "source": "github",
        "repo": "blackwoodseven/liftroi-plugins"
      }
    },
    "portal": {
      "source": {
        "source": "github",
        "repo": "spotify/portal-ai-plugins"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "low"
    }
  },
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
